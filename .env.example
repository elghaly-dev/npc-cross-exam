# Copy into your shell, not into a committed file. Leave NEBIUS_API_KEY empty for the mock model.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_JSON_MODE=json_object
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_BURST=8
DAILY_MODEL_CALLS=1500
ALLOWED_ORIGINS=
# Signs question receipts. Any long random string; leave empty locally for a per-run key.
RECEIPT_SECRET=
